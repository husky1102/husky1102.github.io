{
  "name": "husky1102.github.io",
  "version": "0.8.1.1",
  "private": true,
  "description": "Build scripts for husky1102's personal academic website",
  "repository": {
    "type": "git",
    "url": "https://github.com/husky1102/husky1102.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/husky1102/husky1102.github.io/issues"
  },
  "homepage": "https://husky1102.github.io",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fitvids": "^2.1.1",
    "gsap": "^3.15.0",
    "jquery": "^3.7.1",
    "jquery-smooth-scroll": "^2.2.0",
    "magnific-popup": "^1.2.0"
  },
  "devDependencies": {
    "onchange": "^7.1.0",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "uglify:main": "uglifyjs node_modules/jquery/dist/jquery.min.js node_modules/fitvids/dist/fitvids.min.js node_modules/magnific-popup/dist/jquery.magnific-popup.min.js node_modules/jquery-smooth-scroll/jquery.smooth-scroll.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "uglify:home-motion": "uglifyjs node_modules/gsap/dist/gsap.min.js node_modules/gsap/dist/ScrollTrigger.min.js assets/js/_home-motion.js -c -m -o assets/js/home-motion.min.js",
    "uglify": "npm run uglify:main && npm run uglify:home-motion",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -e \"assets/js/home-motion.min.js\" -- npm run build:js",
    "build:js": "npm run uglify",
    "build:font": "python3 scripts/subset_site_font.py",
    "check:font": "python3 scripts/subset_site_font.py --check-generated",
    "pretest": "npm run build:font && npm run check:font",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test tests/*.test.js",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v"
  }
}
